package tyre

version = 0.1.0
brief   = "A typed regex parser"

sourcedir = "src"
depends = contrib

modules =   TyRE.Codes
          , TyRE.Core
          , TyRE.RE
          , TyRE.StringRE
          -- typed parser
          , TyRE.Parser
          , TyRE.Parser.SM
          , TyRE.Parser.SMConstruction
          , TyRE.Parser.GroupThompson
          , TyRE.Parser.Compile
          , TyRE.Parser.Compile.Runtime
          --- additional more `generic` functions and structures
          , TyRE.Extra
          , TyRE.Extra.Elab
          , TyRE.Extra.Idris
          , TyRE.Extra.Pred
          , TyRE.Extra.Reflects
          -- main export
          , Data.Regex
          -- examples
          , Data.Regex.CommonRegexes
          , Data.Regex.DateAndTime
          -- other
          , TyRE.DisjointMatches
